<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="professionalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#764ba2;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f093fb;stop-opacity:1" />
    </linearGradient>
    <pattern id="tarotPattern" x="0" y="0" width="80" height="120" patternUnits="userSpaceOnUse">
      <rect x="10" y="10" width="25" height="40" rx="2" fill="rgba(255,255,255,0.1)" stroke="rgba(255,215,0,0.3)" stroke-width="1"/>
      <rect x="45" y="70" width="25" height="40" rx="2" fill="rgba(255,255,255,0.08)" stroke="rgba(255,215,0,0.2)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <!-- 背景 -->
  <rect width="800" height="400" fill="url(#professionalGrad)"/>
  <rect width="800" height="400" fill="url(#tarotPattern)" opacity="0.4"/>
  
  <!-- 专业塔罗师桌面 -->
  <ellipse cx="400" cy="350" rx="300" ry="40" fill="rgba(0,0,0,0.2)"/>
  
  <!-- 塔罗牌展开 -->
  <g transform="translate(200,200)">
    <!-- 中央牌 -->
    <rect x="-15" y="-25" width="30" height="50" rx="3" fill="#1a1a2e" stroke="#ffd700" stroke-width="2"/>
    <rect x="-12" y="-22" width="24" height="44" rx="2" fill="#764ba2"/>
    <circle cx="0" cy="0" r="8" fill="#ffd700" opacity="0.8"/>
    
    <!-- 左侧牌 -->
    <g transform="rotate(-20)">
      <rect x="-50" y="-25" width="30" height="50" rx="3" fill="#1a1a2e" stroke="#ffd700" stroke-width="1" opacity="0.8"/>
      <rect x="-47" y="-22" width="24" height="44" rx="2" fill="#667eea" opacity="0.8"/>
    </g>
    
    <!-- 右侧牌 -->
    <g transform="rotate(20)">
      <rect x="20" y="-25" width="30" height="50" rx="3" fill="#1a1a2e" stroke="#ffd700" stroke-width="1" opacity="0.8"/>
      <rect x="23" y="-22" width="24" height="44" rx="2" fill="#f093fb" opacity="0.8"/>
    </g>
  </g>
  
  <!-- 神秘符号 -->
  <g fill="#ffd700" opacity="0.6">
    <text x="100" y="100" font-family="serif" font-size="40">☽</text>
    <text x="650" y="120" font-family="serif" font-size="35">☾</text>
    <text x="550" y="300" font-family="serif" font-size="30">✦</text>
    <text x="150" y="320" font-family="serif" font-size="25">✧</text>
  </g>
  
  <!-- 能量光环 -->
  <circle cx="400" cy="200" r="120" fill="none" stroke="#ffd700" stroke-width="1" opacity="0.3"/>
  <circle cx="400" cy="200" r="100" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.2"/>
  
  <!-- 装饰星星 -->
  <g fill="#ffffff" opacity="0.7">
    <circle cx="80" cy="80" r="2"/>
    <circle cx="720" cy="60" r="1.5"/>
    <circle cx="50" cy="250" r="1"/>
    <circle cx="750" cy="280" r="2"/>
    <circle cx="600" cy="50" r="1"/>
  </g>
</svg>