<svg width="200" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#16213e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f3460;stop-opacity:1" />
    </linearGradient>
    <pattern id="stars" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1" fill="#ffd700" opacity="0.8"/>
      <circle cx="5" cy="10" r="0.5" fill="#ffffff" opacity="0.6"/>
      <circle cx="35" cy="30" r="0.5" fill="#ffffff" opacity="0.4"/>
    </pattern>
  </defs>
  
  <!-- 卡片背景 -->
  <rect x="5" y="5" width="190" height="290" rx="10" ry="10" fill="url(#cardGrad)" stroke="#ffd700" stroke-width="2"/>
  
  <!-- 星空背景 -->
  <rect x="15" y="15" width="170" height="270" rx="5" ry="5" fill="url(#stars)"/>
  
  <!-- 中央装饰图案 -->
  <circle cx="100" cy="150" r="60" fill="none" stroke="#ffd700" stroke-width="2" opacity="0.8"/>
  <circle cx="100" cy="150" r="40" fill="none" stroke="#ffd700" stroke-width="1" opacity="0.6"/>
  
  <!-- 神秘符号 -->
  <polygon points="100,110 110,130 130,130 116,142 122,162 100,150 78,162 84,142 70,130 90,130" fill="#ffd700" opacity="0.9"/>
  
  <!-- 装饰线条 -->
  <line x1="30" y1="50" x2="170" y2="50" stroke="#ffd700" stroke-width="1" opacity="0.5"/>
  <line x1="30" y1="250" x2="170" y2="250" stroke="#ffd700" stroke-width="1" opacity="0.5"/>
  
  <!-- 角落装饰 -->
  <circle cx="30" cy="30" r="3" fill="#ffd700" opacity="0.7"/>
  <circle cx="170" cy="30" r="3" fill="#ffd700" opacity="0.7"/>
  <circle cx="30" cy="270" r="3" fill="#ffd700" opacity="0.7"/>
  <circle cx="170" cy="270" r="3" fill="#ffd700" opacity="0.7"/>
  
  <!-- 中央文字 -->
  <text x="100" y="190" font-family="serif" font-size="12" text-anchor="middle" fill="#ffd700" opacity="0.8">TAROT</text>
</svg>