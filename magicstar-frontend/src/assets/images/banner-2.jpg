<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="fortuneGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff9a9e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#fecfef;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fecfef;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="sunGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#ffd700;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#ff6b6b;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  
  <!-- 背景 -->
  <rect width="800" height="400" fill="url(#fortuneGrad)"/>
  
  <!-- 太阳/月亮 -->
  <circle cx="650" cy="80" r="50" fill="url(#sunGrad)"/>
  <circle cx="650" cy="80" r="35" fill="none" stroke="#ffd700" stroke-width="2" opacity="0.6"/>
  
  <!-- 星座图案 -->
  <g stroke="#ff6b6b" stroke-width="2" fill="none" opacity="0.6">
    <circle cx="150" cy="120" r="3" fill="#ff6b6b"/>
    <circle cx="200" cy="100" r="3" fill="#ff6b6b"/>
    <circle cx="250" cy="140" r="3" fill="#ff6b6b"/>
    <circle cx="300" cy="110" r="3" fill="#ff6b6b"/>
    <line x1="150" y1="120" x2="200" y2="100"/>
    <line x1="200" y1="100" x2="250" y2="140"/>
    <line x1="250" y1="140" x2="300" y2="110"/>
  </g>
  
  <!-- 运势符号 -->
  <text x="100" y="300" font-family="serif" font-size="60" fill="#ff6b6b" opacity="0.4">♈</text>
  <text x="200" y="350" font-family="serif" font-size="40" fill="#ffd700" opacity="0.5">♉</text>
  <text x="500" y="320" font-family="serif" font-size="50" fill="#ff6b6b" opacity="0.3">♊</text>
  
  <!-- 装饰云朵 -->
  <ellipse cx="400" cy="80" rx="60" ry="20" fill="rgba(255,255,255,0.3)"/>
  <ellipse cx="380" cy="70" rx="40" ry="15" fill="rgba(255,255,255,0.2)"/>
  <ellipse cx="420" cy="70" rx="30" ry="12" fill="rgba(255,255,255,0.2)"/>
  
  <!-- 流星 -->
  <line x1="300" y1="200" x2="350" y2="250" stroke="#ffd700" stroke-width="3" opacity="0.7"/>
  <circle cx="300" cy="200" r="3" fill="#ffd700" opacity="0.8"/>
</svg>