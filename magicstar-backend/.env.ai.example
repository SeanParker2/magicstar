# AI服务配置示例
# 复制此文件为 .env 并填入实际值

# ================================
# OpenAI API 配置
# ================================

# OpenAI API密钥（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI组织ID（可选）
OPENAI_ORGANIZATION=org-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API基础URL（可选，默认为官方API）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 默认使用的模型
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo

# 请求超时时间（毫秒）
OPENAI_TIMEOUT=60000

# ================================
# 重试机制配置
# ================================

# 最大重试次数
OPENAI_MAX_RETRIES=3

# 基础延迟时间（毫秒）
OPENAI_BASE_DELAY=1000

# 最大延迟时间（毫秒）
OPENAI_MAX_DELAY=30000

# 退避倍数
OPENAI_BACKOFF_MULTIPLIER=2

# ================================
# 提示词配置
# ================================

# 最大提示词长度（字符数）
AI_MAX_PROMPT_LENGTH=4000

# 默认语言
AI_DEFAULT_LANGUAGE=zh-CN

# ================================
# 缓存配置
# ================================

# 是否启用缓存
AI_CACHE_ENABLED=true

# 缓存过期时间（秒）
AI_CACHE_TTL=3600

# 最大缓存条目数
AI_CACHE_MAX_SIZE=1000

# 缓存键前缀
AI_CACHE_KEY_PREFIX=ai:cache:

# ================================
# 队列配置
# ================================

# 是否启用队列
AI_QUEUE_ENABLED=true

# 并发处理数
AI_QUEUE_CONCURRENCY=5

# 队列最大重试次数
AI_QUEUE_MAX_RETRIES=3

# 队列重试延迟（毫秒）
AI_QUEUE_RETRY_DELAY=5000

# 队列任务超时时间（毫秒）
AI_QUEUE_TIMEOUT=300000

# ================================
# 限流配置
# ================================

# 是否启用限流
AI_RATE_LIMIT_ENABLED=true

# 时间窗口内最大请求数
AI_RATE_LIMIT_MAX_REQUESTS=100

# 时间窗口大小（毫秒）
AI_RATE_LIMIT_WINDOW_MS=60000

# 是否跳过成功请求的计数
AI_RATE_LIMIT_SKIP_SUCCESSFUL=true

# ================================
# 监控配置
# ================================

# 是否启用监控
AI_MONITORING_ENABLED=true

# 日志级别
AI_LOG_LEVEL=info

# 是否启用指标收集
AI_METRICS_ENABLED=true

# 是否启用链路追踪
AI_TRACING_ENABLED=false

# ================================
# Redis配置（用于缓存和队列）
# ================================

# Redis连接URL
REDIS_URL=redis://localhost:6379

# Redis主机
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis密码（如果有）
# REDIS_PASSWORD=your_redis_password

# Redis数据库索引
REDIS_DB=0

# ================================
# 数据库配置
# ================================

# 数据库类型
DB_TYPE=mysql

# 数据库主机
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库名称
DB_NAME=magicstar

# 数据库用户名
DB_USERNAME=root

# 数据库密码
DB_PASSWORD=your_password

# 是否同步数据库结构（开发环境可设为true）
DB_SYNCHRONIZE=false

# 是否记录SQL日志
DB_LOGGING=false

# ================================
# 应用配置
# ================================

# 应用端口
PORT=3000

# 应用环境
NODE_ENV=development

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here

# JWT过期时间
JWT_EXPIRES_IN=7d

# ================================
# 文件上传配置
# ================================

# 上传文件最大大小（字节）
MAX_FILE_SIZE=10485760

# 上传目录
UPLOAD_DIR=./uploads

# ================================
# 邮件配置（用于通知）
# ================================

# SMTP主机
# SMTP_HOST=smtp.gmail.com

# SMTP端口
# SMTP_PORT=587

# SMTP用户名
# SMTP_USER=your_email@gmail.com

# SMTP密码
# SMTP_PASS=your_email_password

# 发件人邮箱
# FROM_EMAIL=noreply@magicstar.com